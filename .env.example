# Copy this file to .env and fill in your real values.
# Never commit the real .env file.

# --- Supabase (optional - required for saving/loading/export records) -----
# Master switch. Keep false (default) to run the app as a pure local
# PDF -> Excel converter with no cloud calls at all. When enabled, extracted
# invoice records are upserted to the invoice_records table and Excel is
# generated from those records. Uploaded PDF files are NOT stored.
ENABLE_SUPABASE_SAVE=false
SUPABASE_URL=
# Server-side Secret key (`sb_secret_...`) from Settings > API Keys > Secret keys.
# It replaces the legacy `service_role` JWT key (deprecated by end of 2026).
# The app reads SUPABASE_SECRET_KEY first, falling back to
# SUPABASE_SERVICE_ROLE_KEY for projects still on the legacy key.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# --- Optional (Azure Document Intelligence) ------------------------------
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
