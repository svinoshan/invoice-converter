# Copy this file to .env and fill in your real values.
# Never commit the real .env file.

# --- Supabase (optional - required only for "Save to Supabase") -----------
# Master switch. Keep false (default) to run the app as a pure local
# PDF -> Excel converter with no cloud calls at all.
ENABLE_SUPABASE_SAVE=false
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=invoice-pdfs

# --- Optional (Azure Document Intelligence) ------------------------------
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
